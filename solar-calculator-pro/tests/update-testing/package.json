{
  "name": "update-testing",
  "version": "1.0.0",
  "description": "Comprehensive testing suite for auto-update system",
  "main": "test-environment.js",
  "scripts": {
    "setup": "node test-environment.js setup",
    "cleanup": "node test-environment.js cleanup",
    "verify": "node test-environment.js verify",
    "server": "node mock-update-server.js",
    "server:custom": "node mock-update-server.js --port 3001",
    "test": "npm run test:flow && npm run test:rollback",
    "test:flow": "node test-update-flow.js",
    "test:rollback": "node test-rollback.js",
    "test:all": "npm run setup && npm run server & sleep 2 && npm test",
    "build:versions": "node version-builder.js --all"
  },
  "keywords": [
    "electron",
    "update",
    "testing",
    "auto-update"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "axios": "^1.6.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=16.0.0"
  }
}
