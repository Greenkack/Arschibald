else $("#messagedivhtml").html(contenthtml);if(sizex>0&&sizey>0){$("#messagedivtarget").css("width",sizex+"px");$("#messagedivtarget").css("height",sizey>1?sizey+"px":"auto")}else if(sizex>0)$("#messagedivtarget").css("width",sizex+"px");else if(sizey>0)$("#messagedivtarget").css("height",sizey>1?sizey+"px":"auto");else{$("#messagedivtarget").css("width",msgwidthconf+"px");$("#messagedivtarget").css("height",msgheightconf+"px")}if(modal==1){conf.closeOnClick=false;conf.closeOnEsc=false;$("#messagedivtarget .close").hide()}else{conf.closeOnClick=
