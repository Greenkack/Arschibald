// /core/jquery.ianappdetail.js
function scart_amount_change(scprice,ssuffix,schange){var newprice=scprice-0;var statusdel=0;$("#os_detail_view :input").each(function(){var fname=$(this).attr("name");var fvalu=$(this).val();if(typeof fname==="string"&&fname.match(/^dd/)){var ftype=$(this).prop("type");if(ftype!="text"&&ftype!="password"&&ftype!="textarea"){var fvar=new Array;if(fname=="dd1_01"){fvar=fvalu.split(",");if(fvar[1]>0||fvar[1]<0)newprice=newprice-scprice;if(fvar[3]==0)fvar[3]=shipstdv;if(fvar[3]>statusdel)statusdel=fvar[3]}else{fvar=
fvalu.split(";");if(fvar[4]==0)fvar[4]=shipstdv;if(fvar[4]>statusdel)statusdel=fvar[4]}var addprice=fvar[1]-0;if(addprice>0||addprice<0)newprice=newprice+addprice-0}}});if(typeof shipping[statusdel]!=="undefined"){var statusid=statusdel==0?shipstdv:statusdel;var statusof=0;if(typeof shipstos==="string"){var sscartoff=shipstos.split("|");if($.inArray(statusdel,sscartoff)>=0)statusof=1}if(statusdel==shipstou||statusof==1){$("#detailtmpbut").hide();$("#detailtmpcon").show()}else{$("#detailtmpbut").show();
$("#detailtmpcon").hide()}$("#detailtmpdel").html('<span class="os_list_shipt'+statusdel+'"><img src="'+syspathpics+"/status_"+statusid+'.gif" alt="'+shipping[statusdel]+'" /> '+shipping[statusdel]+"</span>")}newprice=scart_amount_round(newprice);$("#detailtmpsum").html(newprice+" "+ssuffix)}
function scart_amount_round(x){var numberStr=parseFloat(x).toFixed(2).toString();var numFormatDec=numberStr.slice(-2);numberStr=numberStr.substring(0,numberStr.length-3);var numFormat=new Array;while(numberStr.length>3){numFormat.unshift(numberStr.slice(-3));numberStr=numberStr.substring(0,numberStr.length-3)}numFormat.unshift(numberStr);return numFormat.join(".")+","+numFormatDec};

// /core/jquery.ianapphelper.js
function navimainhide(nid){$("#nav"+nid).css("display","none")}function navimainset(nid){$("#nav"+nid).css("display","block")}function navihide(nid){$("#nav"+nid).css("visibility","hidden")}function naviset(nid){$("#nav"+nid).css("visibility","visible")}function wurl(link){location.href=link;return false}
function wopen(link,wi,he){var width=wi;var height=he;var l=(screen.availWidth-width)/2;var t=(screen.availHeight-height)/2;wincom=window.open(link,"oswin","toolbar=0,location=0,directories=0,status=0,menubar=0,scrollbars=1,resizable=0,width="+wi+",height="+he+",screenX="+l+",screenY="+t+",left="+l+",top="+t);if(wincom)wincom.focus();else alert(statustext)}function dellink(link,btext){Check=confirm(btext);if(Check==false)return;else window.open(link,"_self")}
function fielddel(f){if(f.value==f.defaultValue)f.value=""}function fieldset(f){if(f.value=="")f.value=f.defaultValue}function fieldemp(f){if(f.sbeg.value==f.sbeg.defaultValue)f.sbeg.value=""}function tabbgcolor(tabid,hrefid){if($("#"+tabid).length)$("#"+tabid).addClass("os_head_navi_active_cell");if($("#"+hrefid).length)$("#"+hrefid).addClass("os_head_navi_active_href")}
function getUrlVars(){var vars={},hash;var hashes=window.location.href.slice(window.location.href.indexOf("?")+1).split("&");for(var key in hashes){hash=hashes[key].split("=");vars[hash[0]]=hash[1]}return vars}jQuery.fn.prevDoubleSubmit=function(){jQuery(this).submit(function(){if(this.beenSubmitted)return false;else this.beenSubmitted=true})};function MenuView(subm){var mlink=$(subm);mlink.find("a:first").addClass("act");mlink.find("ul").css("display","block")}
function MenuHide(subm){var mlink=$(subm);mlink.find("a:first").removeClass("act");mlink.find("ul").css("display","none")}function TmplChange(type,page){$.ajax({type:"GET",cache:false,url:syspathshop+"?func=searchcheck&action=ctmpl&ajax=1&wkid="+scartsession,data:"type="+type+"&page="+page,dataType:"html",error:function(jqXHR,textStatus,errorThrown){document.location.reload(true)},success:function(data,textStatus,jqXHR){if(data==1)document.location.reload(true)}});return false}
function AjaxErrorLog(reqobj,message){console.log(reqobj+" | "+message);$.ajax({type:"POST",cache:false,async:true,data:"message="+reqobj+" # "+message,url:syspathpics+"/appserv/stats/logajax.php?wkid="+scartsession+"&time="+$.now(),error:function(jqXHR,textStatus,errorThrown){},success:function(data,textStatus,jqXHR){},complete:function(jqXHR,textStatus){}})};

